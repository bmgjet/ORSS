<Project Sdk="Microsoft.NET.Sdk">
  <!-- An OkiRomSim Studio plugin: a class library that references the app (not copied: the app's own copy is used when it loads). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OkiRomSim.ScanTool</AssemblyName>
    <RootNamespace>ScanToolPlugin</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- nothing the app already has goes beside the plugin: Avalonia, System.IO.Ports and the app itself come from the app -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OkiRomSim.Desktop\OkiRomSim.Desktop.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <!-- also put it in the app's Plugins folder, where Settings > Plugins offers it -->
  <Target Name="CopyToAppPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\..\OkiRomSim.Desktop\bin\$(Configuration)\$(TargetFramework)\Plugins" SkipUnchangedFiles="true" />
  </Target>
</Project>
