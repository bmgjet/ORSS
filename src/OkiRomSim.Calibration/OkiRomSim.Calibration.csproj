<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- the feature file lives with the ROM listings it was built from, and ships next to every program -->
    <None Include="..\..\roms\features.json" Link="features.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\roms\features.json')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OkiRomSim.Assembler\OkiRomSim.Assembler.csproj" />
    <ProjectReference Include="..\OkiRomSim.Core\OkiRomSim.Core.csproj" />
  </ItemGroup>
</Project>
