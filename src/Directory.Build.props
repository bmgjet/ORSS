<Project>
  <!-- One place for the version every part of the program reports (title bar, Settings > General, the Debug page and the MCP handshake all read it through OkiRomSim.Core.BuildInfo). -->
  <PropertyGroup>
    <Version>0.0.0.8</Version>
    <AssemblyVersion>0.0.0.8</AssemblyVersion>
    <FileVersion>0.0.0.8</FileVersion>
    <InformationalVersion>0.0.0.8</InformationalVersion>
    <Company>bmgjet</Company>
    <Product>Rom Sim Studio</Product>
    <Authors>bmgjet</Authors>
    <Copyright>Copyright (c) bmgjet. All rights reserved.</Copyright>
  </PropertyGroup>
</Project>
